{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/exigir-rama.sh",
            "statusMessage": "Verificando la rama…",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
